# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- supabase ---
# required. without these the app shows a setup screen (there is no demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only. never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- stock prices: chainlink only ---
# data_feeds (default): chainlink data feeds for coinbase tokenized stocks on base mainnet. free, read-only, no key.
# data_streams: the paid chainlink data streams api (needs the CHAINLINK_DS_* credentials below)
CHAINLINK_PRICE_SOURCE=data_feeds
# optional: a base mainnet rpc for reading the feeds (default https://mainnet.base.org). reads only, never transacts.
BASE_MAINNET_RPC_URL=

# server only. data streams credentials from chainlink (https://app.chain.link). never NEXT_PUBLIC_.
CHAINLINK_DS_API_KEY=
CHAINLINK_DS_USER_SECRET=
# testnet (default) pairs with chainlink's base sepolia verifier proxy. mainnet reports can't be verified there.
CHAINLINK_DS_NETWORK=testnet
# optional overrides (defaults are the sdk's documented endpoints for the network)
CHAINLINK_DS_API_URL=
CHAINLINK_DS_WS_URL=
# optional data-quality thresholds
CHAINLINK_LIVE_STALE_S=300
CHAINLINK_SETTLEMENT_MAX_AGE_S=120
CHAINLINK_MAX_SPREAD_BPS=200
CHAINLINK_UNEXPLAINED_MOVE_PCT=40

# --- settlement ---
# shared secret for the cron settlement endpoint and /api/chainlink/discover (bearer token)
CRON_SECRET=

# --- base sepolia wallets (coinbase developer platform) ---
# everything onchain is base sepolia (84532) only; there is no mainnet setting.
# public: cdp project id (portal.cdp.coinbase.com). blank = wallets switched off.
NEXT_PUBLIC_CDP_PROJECT_ID=
# supabase = the beef login is the wallet login (cdp custom auth, needs the supabase jwks url in the portal)
# cdp      = cdp email code / google, using the same email as the beef account
NEXT_PUBLIC_CDP_AUTH=cdp
# true = the cdp sdk's mock mode, for local ui work without a project
NEXT_PUBLIC_CDP_MOCK=false
# server only: cdp secret api key, used to verify end-user access tokens
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# server only: your cdp paymaster & bundler endpoint for base sepolia (portal → paymaster).
# never exposed: the browser only sees beef's /api/paymaster proxy
CDP_PAYMASTER_URL=
# deployed BeefEscrow on base sepolia (npm run contracts:deploy). blank = onchain stakes off
NEXT_PUBLIC_ESCROW_ADDRESS=
# stake limits per participant, in test usdc (whole cents). must equal the deployed escrow's
# minStake/maxStake and the database's duels_stake_check. /api/wallet/status reports a mismatch.
NEXT_PUBLIC_STAKE_MIN_USDC=1
NEXT_PUBLIC_STAKE_MAX_USDC=1000
# server only: signs settlement results; its address is the escrow's oracle
SETTLEMENT_ORACLE_PRIVATE_KEY=
# optional: a dedicated base sepolia rpc (default: public sepolia.base.org)
BASE_SEPOLIA_RPC_URL=
# sponsorship limits enforced by beef's paymaster proxy
SPONSOR_PER_USER_DAILY=10
SPONSOR_GLOBAL_DAILY=500
