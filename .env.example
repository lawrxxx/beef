# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- supabase (leave blank to run in demo mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only. never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- market data ---
# mock | polygon | finnhub | alphavantage
MARKET_DATA_PROVIDER=mock
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- settlement ---
# shared secret required by the cron settlement endpoint (vercel sends it as a bearer token)
CRON_SECRET=

# --- base / chain ---
# base | base-sepolia
NEXT_PUBLIC_CHAIN=base-sepolia
NEXT_PUBLIC_ESCROW_ADDRESS=
# real money stays off until legal, custody and oracle review is complete
NEXT_PUBLIC_REAL_MONEY_ENABLED=false
